      "Bash(npx --yes playwright@1.48.0 install chromium --with-deps)",
      "Bash(curl *)",
      "Bash(echo \"TSC:$?\")",
      "Bash(npx eslint *)",
      "Bash(echo \"LINT:$?\")",
      "Bash(timeout 20 npx --yes playwright@1.48.0 --version)",
      "Bash(echo \"EXIT:$?\")",
      "Bash(timeout 30 npx --yes playwright@1.48.0 install chromium)",
      "Bash(git mv *)"
